# Environment Variables
# Copy this file to .env.local and add your API keys

# Groq API Configuration (Financial AI Assistant)
GROQ_API_KEY=your_groq_api_key_here


# Instructions:
# 1. Replace placeholder with your actual Groq API key
# 2. Get your key from: https://console.groq.com/keys
